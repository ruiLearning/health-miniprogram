.page-wrap {
  min-height: 100vh;
  padding: 28rpx 24rpx 40rpx;
  background: linear-gradient(180deg, #f6fbf8 0%, #f4f6fa 28%, #f4f6fa 100%);
  box-sizing: border-box;
}

.hero-card {
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1aad74 0%, #58c78f 100%);
  color: #fff;
  box-shadow: 0 18rpx 48rpx rgba(26, 173, 116, 0.18);
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  opacity: 0.78;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  opacity: 0.92;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-metric {
  padding: 22rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(6px);
}

.hero-metric-value {
  font-size: 36rpx;
  font-weight: 700;
}

.hero-metric-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
}

.summary-card {
  padding: 26rpx 24rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.05);
}

.summary-card.green {
  background: linear-gradient(180deg, #f1fbf6 0%, #ffffff 100%);
}

.summary-card.blue {
  background: linear-gradient(180deg, #f1f7ff 0%, #ffffff 100%);
}

.summary-card.amber {
  background: linear-gradient(180deg, #fff8ee 0%, #ffffff 100%);
}

.summary-card.coral {
  background: linear-gradient(180deg, #fff3f2 0%, #ffffff 100%);
}

.summary-label {
  font-size: 24rpx;
  color: #64748b;
}

.summary-value {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #122033;
}

.summary-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.section-head {
  margin: 34rpx 6rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #122033;
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.top-tab-scroll {
  margin-top: 8rpx;
  white-space: nowrap;
}

.top-tab-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0 8rpx;
}

.top-tab {
  flex-shrink: 0;
  padding: 18rpx 26rpx;
  border-radius: 999rpx;
  background: #eaf1ec;
  color: #5f6b7a;
  font-size: 24rpx;
  font-weight: 600;
}

.top-tab-active {
  background: #1aad74;
  color: #fff;
  box-shadow: 0 10rpx 26rpx rgba(26, 173, 116, 0.22);
}

.top-tab-hover {
  transform: scale(0.97);
  opacity: 0.88;
}

.module-swiper {
  height: 980rpx;
  margin-top: 16rpx;
}

.module-scroll {
  height: 100%;
}

.module-panel {
  min-height: 100%;
  padding: 32rpx 28rpx;
  padding-bottom: 40rpx;
  border-radius: 30rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 14rpx 40rpx rgba(15, 23, 42, 0.06);
  transition: transform 0.16s ease, box-shadow 0.16s ease, opacity 0.16s ease;
}

.module-panel-hover {
  transform: scale(0.992);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
  opacity: 0.96;
}

.module-green {
  background: linear-gradient(180deg, #f1fbf6 0%, #ffffff 100%);
  border-top: 10rpx solid #1aad74;
}

.module-amber {
  background: linear-gradient(180deg, #fff8ee 0%, #ffffff 100%);
  border-top: 10rpx solid #f59e0b;
}

.module-blue {
  background: linear-gradient(180deg, #f1f7ff 0%, #ffffff 100%);
  border-top: 10rpx solid #3b82f6;
}

.module-purple {
  background: linear-gradient(180deg, #f6f1ff 0%, #ffffff 100%);
  border-top: 10rpx solid #8b5cf6;
}

.module-coral {
  background: linear-gradient(180deg, #fff3f2 0%, #ffffff 100%);
  border-top: 10rpx solid #ef4444;
}

.module-head {
  min-height: 180rpx;
}

.entry-badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 20rpx;
  color: #64748b;
}

.entry-title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #122033;
}

.entry-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #667085;
}

.module-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.module-stat {
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.86);
}

.module-stat-label {
  font-size: 22rpx;
  color: #7b8794;
}

.module-stat-value {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #122033;
  word-break: break-all;
}

.module-stat-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.module-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: inset 0 0 0 2rpx #edf2f7;
  transition: transform 0.16s ease, background 0.16s ease, box-shadow 0.16s ease;
}

.module-action-hover {
  transform: scale(0.985);
  background: #f8fafc;
  box-shadow: inset 0 0 0 2rpx #dbe3ee;
}

.module-action-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #122033;
}

.inline-section {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.8);
}

.inline-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #122033;
}

.macro-chart-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  margin-bottom: 8rpx;
}

.macro-pie-canvas {
  width: 360rpx;
  height: 360rpx;
}

.macro-preview {
  margin-top: 18rpx;
}

.macro-preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #475569;
}

.macro-preview-label-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.macro-preview-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.macro-preview-label {
  font-weight: 600;
}

.macro-preview-track {
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.macro-preview-fill {
  height: 100%;
  border-radius: inherit;
}

.water-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.water-cup {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: transparent;
}

.water-cup-filled {
  background: #60a5fa;
}

.task-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.task-chip {
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 22rpx;
}

.task-chip-done {
  background: #dcfce7;
  color: #15803d;
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 22rpx;
}

.trend-item {
  flex: 1;
  text-align: center;
}

.trend-bar-wrap {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 110rpx;
}

.trend-bar {
  width: 28rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: linear-gradient(180deg, #34d399 0%, #1aad74 100%);
}

.trend-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.rate-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.rate-pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #15803d;
  font-size: 22rpx;
}

.article-preview {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
}

.article-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #8b5cf6;
  flex-shrink: 0;
}

.article-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
}

.settings-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 18rpx;
}

.setting-item {
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  background: #fff;
}

.setting-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.setting-value {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #122033;
}

.entry-arrow {
  margin-left: 24rpx;
  font-size: 42rpx;
  color: #94a3b8;
}
