/* pages/diet/diet.wxss */

/* ── Header ── */
.diet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding: 0 4rpx;
}
.diet-greeting {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.diet-date {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.header-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1AAD74, #0E9058);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}
.header-avatar.avatar-image {
  display: block;
  object-fit: cover;
  background: #E5E7EB;
}

.history-strip {
  margin-bottom: 24rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.history-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.history-state {
  font-size: 22rpx;
  color: #8A94A6;
}

.history-picker {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #EDF3F8;
  font-size: 22rpx;
  color: #536173;
}

.history-scroll {
  display: flex;
  gap: 8rpx;
}

.history-chip {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  border-radius: 24rpx;
  background: #F6F8FB;
  color: #7B8798;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.history-chip.today {
  background: #FFF6E8;
  color: #A16207;
  border-color: #F3D08B;
}

.history-chip.has-data {
  background: linear-gradient(180deg, #EFFAF3 0%, #E1F4E8 100%);
  color: #1F6A47;
  border-color: #9ED6B5;
  box-shadow: inset 0 0 0 1rpx rgba(158, 214, 181, 0.35);
}

.history-chip.future {
  background: #F3F4F6;
  color: #B3BBC7;
  border-color: #E5E7EB;
  box-shadow: none;
}

.history-chip.active {
  background: linear-gradient(135deg, #1AAD74, #159764);
  color: #FFFFFF;
  box-shadow: 0 10rpx 22rpx rgba(26, 173, 116, 0.22);
  border-color: transparent;
}

.history-chip.today.active,
.history-chip.has-data.active,
.history-chip.future.active {
  color: #FFFFFF;
}

.history-chip-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1AAD74;
}

.history-chip-week {
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.history-chip-day {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1;
}

/* ── Summary Card ── */
.summary-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.07);
}

.plan-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
  padding: 22rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff6d8, #eef9ea);
}

.plan-banner-left {
  flex: 1;
  min-width: 0;
}

.plan-banner-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2d24;
}

.plan-banner-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #72806f;
}

.plan-banner-right {
  text-align: right;
}

.plan-banner-kcal {
  font-size: 36rpx;
  font-weight: 800;
  color: #0e9058;
  line-height: 1;
}

.plan-banner-unit {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7a8c80;
}

.plan-method {
  margin-top: 18rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(141, 160, 132, 0.16);
}

.plan-method-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #314438;
}

.plan-method-desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.65;
  color: #6b7d71;
}

.plan-method-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.plan-method-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.plan-adjust-toggle {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.plan-adjust-toggle-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #314438;
}

.plan-adjust-toggle-meta {
  font-size: 21rpx;
  color: #0E9058;
  font-weight: 700;
}

.plan-adjust {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(141, 160, 132, 0.16);
}

.plan-adjust-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.plan-adjust-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #314438;
}

.plan-adjust-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #E9F8EF;
  color: #0E9058;
  font-size: 20rpx;
  font-weight: 700;
}

.plan-adjust-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.plan-adjust-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.plan-adjust-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #1AAD74;
  flex-shrink: 0;
}

.plan-adjust-text {
  flex: 1;
  font-size: 21rpx;
  line-height: 1.7;
  color: #566273;
}

.summary-inner {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 28rpx;
}

/* Ring */
.ring-container {
  position: relative;
  width: 200px;
  height: 200px;
  flex-shrink: 0;
}
.ring-canvas {
  width: 200px;
  height: 200px;
}
.ring-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}
.ring-kcal {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  line-height: 1;
}
.ring-unit {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
.ring-pct {
  font-size: 22rpx;
  font-weight: 600;
  color: #1AAD74;
  margin-top: 4rpx;
}

/* Macros */
.macros-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.macro-item {}
.macro-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.macro-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.macro-label {
  font-size: 24rpx;
  color: #888;
  flex: 1;
}
.macro-val {
  font-size: 24rpx;
  font-weight: 700;
}
.macro-target {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94A3B8;
}
.amber { color: #F08C00; }
.blue { color: #3B82F6; }
.coral { color: #EF4444; }
.green { color: #1AAD74; }

.bar-track {
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.6s ease;
  min-width: 0%;
  max-width: 100%;
}
.amber-fill { background: linear-gradient(90deg, #FFD166, #F08C00); }
.blue-fill  { background: linear-gradient(90deg, #93C5FD, #3B82F6); }
.coral-fill { background: linear-gradient(90deg, #FCA5A5, #EF4444); }

/* Summary Footer */
.summary-footer {
  display: flex;
  gap: 16rpx;
}
.sf-item {
  flex: 1;
  border-radius: 16rpx;
  padding: 16rpx 12rpx;
  text-align: center;
}
.green-bg { background: #ECFDF5; }
.blue-bg  { background: #EFF6FF; }
.amber-bg { background: #FFFBEB; }
.sf-num {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}
.sf-lbl {
  font-size: 20rpx;
  color: #888;
  margin-top: 6rpx;
}

.amber-soft {
  background: #FFF4D6;
  color: #C97A00;
}

.blue-soft {
  background: #EAF3FF;
  color: #2E77E5;
}

.coral-soft {
  background: #FDEBEC;
  color: #DE4B57;
}

/* ── Meal Card ── */
.meal-group {
  margin-bottom: 24rpx;
  padding: 18rpx;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.meal-group-breakfast {
  background: linear-gradient(180deg, #FFF6E7 0%, #FFFBF3 100%);
}

.meal-group-lunch {
  background: linear-gradient(180deg, #EDF9F1 0%, #F8FCF9 100%);
}

.meal-group-dinner {
  background: linear-gradient(180deg, #EEF5FF 0%, #F8FBFF 100%);
}

.meal-group-snack {
  background: linear-gradient(180deg, #F5F0FF 0%, #FBF9FF 100%);
}

.meal-card {
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.meal-card-breakfast {
  background: linear-gradient(180deg, #FFF9EE 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(240, 140, 0, 0.08);
}

.meal-card-lunch {
  background: linear-gradient(180deg, #F3FCF6 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(26, 173, 116, 0.08);
}

.meal-card-dinner {
  background: linear-gradient(180deg, #F3F8FF 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(59, 130, 246, 0.08);
}

.meal-card-snack {
  background: linear-gradient(180deg, #F8F4FF 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
}
.meal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.meal-head-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.meal-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.meal-icon {
  font-size: 36rpx;
}
.meal-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.meal-sub {
  font-size: 22rpx;
  color: #AAA;
  margin-top: 4rpx;
}
.meal-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.meal-kcal-badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 40rpx;
}

.meal-clear-btn {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #FFF1F2;
  color: #E15263;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}
.meal-clear-btn:active {
  opacity: 0.82;
}
.meal-add-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #1AAD74;
  display: flex;
  align-items: center;
  justify-content: center;
}
.meal-add-btn:active { background: #ECFDF5; }
.add-icon {
  font-size: 36rpx;
  color: #1AAD74;
  line-height: 1;
  font-weight: 300;
}

/* Food items */
.food-list { padding-top: 4rpx; }
.food-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}
.food-item:last-child { border-bottom: none; }
.food-left { flex: 1; }
.food-top-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.food-name { font-size: 28rpx; color: #1A1A1A; font-weight: 600; }
.food-sub  { font-size: 20rpx; color: #98A2B3; margin-top: 6rpx; }
.food-main-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}
.food-macro-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.food-macro-pill {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.3;
}

.food-macro-pill-primary {
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
}

.food-macro-pill-muted {
  background: #F3F4F6;
  color: #98A2B3;
}
.food-edit-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  justify-content: flex-end;
  flex-shrink: 0;
  margin-left: 8rpx;
}
.food-edit-label {
  font-size: 18rpx;
  color: #7B8798;
  flex-shrink: 0;
}
.food-edit-input {
  width: 108rpx;
  min-height: 44rpx;
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  background: #F6F8FB;
  font-size: 20rpx;
  color: #1A1A1A;
  box-sizing: border-box;
  text-align: center;
}
.food-edit-unit {
  font-size: 18rpx;
  color: #7B8798;
}
.food-right {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding-left: 12rpx;
}
.food-kcal {
  font-size: 24rpx;
  font-weight: 700;
  color: #516072;
  white-space: nowrap;
}
.food-del-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFF0F0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.del-icon {
  font-size: 26rpx;
  color: #EF4444;
  line-height: 1;
}
.meal-empty {
  padding: 20rpx 0 4rpx;
  font-size: 24rpx;
  color: #CCC;
  text-align: center;
}

.meal-quick-add {
  margin-top: 18rpx;
  padding: 18rpx 0 4rpx;
  border-top: 1rpx solid #EEF2F6;
}

.meal-quick-add-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.meal-quick-add-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #364152;
}

.meal-quick-add-tip {
  font-size: 20rpx;
  color: #8A94A6;
}

.meal-quick-add-foods {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.meal-plan {
  border-radius: 22rpx;
  padding: 22rpx;
}

.meal-plan-card {
  margin: 0;
  box-shadow: 0 6rpx 22rpx rgba(15, 23, 42, 0.05);
}

.meal-plan-amber {
  background: linear-gradient(180deg, #FFF9ED 0%, #FFFFFF 100%);
}

.meal-plan-green {
  background: linear-gradient(180deg, #F2FCF5 0%, #FFFFFF 100%);
}

.meal-plan-blue {
  background: linear-gradient(180deg, #F2F8FF 0%, #FFFFFF 100%);
}

.meal-plan-purple {
  background: linear-gradient(180deg, #F7F2FF 0%, #FFFFFF 100%);
}

.meal-plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  flex-wrap: wrap;
}

.meal-plan-section-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #1F2937;
}

.meal-plan-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #4C5A6A;
  font-size: 20rpx;
  font-weight: 700;
}

.meal-plan-remain {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(230, 248, 238, 0.98), rgba(245, 252, 248, 0.98));
  border: 1rpx solid rgba(26, 173, 116, 0.2);
  box-shadow: 0 8rpx 22rpx rgba(26, 173, 116, 0.08);
}

.meal-plan-remain.is-over {
  background: linear-gradient(135deg, rgba(255, 240, 232, 0.98), rgba(255, 248, 244, 0.98));
  border-color: rgba(239, 68, 68, 0.22);
  box-shadow: 0 8rpx 22rpx rgba(239, 68, 68, 0.08);
}

.meal-plan-remain-head,
.meal-plan-suggest-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.meal-plan-remain-chip,
.meal-plan-suggest-chip {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.meal-plan-remain-chip {
  background: #DDF6E7;
  color: #0B8A54;
}

.meal-plan-remain.is-over .meal-plan-remain-chip {
  background: #FDE7E7;
  color: #D63C3C;
}

.meal-plan-suggest-chip {
  background: #F3F4F6;
  color: #5B6472;
}

.meal-plan-remain-title,
.meal-plan-suggest-title {
  font-size: 21rpx;
  font-weight: 700;
  color: #516072;
}

.meal-plan-suggest {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.8);
}

.meal-plan-options {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.meal-plan-option {
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(247, 249, 252, 0.95);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
}

.meal-plan-option-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.meal-plan-option-label {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #E9EEF5;
  color: #4E5C6E;
  font-size: 19rpx;
  font-weight: 800;
}

.meal-plan-option-action {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #E8F4EC;
  color: #12845A;
  font-size: 19rpx;
  font-weight: 800;
}

.meal-plan-option-foods {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.meal-plan-option-food {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  color: #334155;
  font-size: 20rpx;
  line-height: 1.55;
}

.meal-plan-option-food:active,
.meal-plan-option-action:active {
  opacity: 0.82;
  transform: scale(0.98);
}

.meal-plan-target-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.meal-plan-target-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.meal-plan-suggest-text {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  font-weight: 700;
  color: #1F2937;
}

.meal-plan-suggest-inline {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(249, 251, 252, 0.95), rgba(244, 247, 249, 0.95));
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.meal-plan-suggest-inline-item,
.meal-plan-suggest-inline-action {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

.meal-plan-suggest-inline-item {
  background: #FFFFFF;
  border: 1rpx solid rgba(203, 213, 225, 0.8);
  color: #475569;
  box-shadow: 0 4rpx 10rpx rgba(148, 163, 184, 0.08);
}

.meal-plan-suggest-inline-action {
  margin-left: auto;
  background: linear-gradient(135deg, #1AAD74, #159764);
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(26, 173, 116, 0.18);
}

.meal-plan-suggest-inline-item:active,
.meal-plan-suggest-inline-action:active {
  opacity: 0.84;
  transform: scale(0.98);
}

.kcal-soft {
  background: #EEF4FF;
  color: #5877B3;
}

.meal-plan-status-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.meal-plan-status-pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.over-soft {
  background: #FDEBEC;
  color: #DE4B57;
}

.meal-plan-over-tip {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.65;
  color: #B45309;
}

.meal-plan-chip {
  display: flex;
  align-items: center;
  width: auto;
  max-width: 100%;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.5;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.meal-plan-chip:active {
  transform: scale(0.97);
  opacity: 0.88;
}

.meal-plan-chip-grain {
  background: #FFF3D9;
  color: #C97A00;
}

.meal-plan-chip-protein {
  background: #EAF3FF;
  color: #2E77E5;
}

.meal-plan-chip-veggie {
  background: #EAF9EF;
  color: #1B8F57;
}

.meal-plan-chip-fruit {
  background: #FCEBFF;
  color: #B043C7;
}

.meal-plan-chip-fat {
  background: #FFF0E7;
  color: #C46A32;
}

.meal-plan-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7A8798;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.38);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal-sheet {
  width: 100%;
  height: 78vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 18rpx 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-handle {
  width: 88rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #D9E0E7;
  margin: 0 auto 18rpx;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.modal-close {
  font-size: 24rpx;
  color: #1AAD74;
  font-weight: 700;
}

.modal-search {
  margin-bottom: 18rpx;
}

.modal-cat-tabs {
  margin-bottom: 18rpx;
  flex-shrink: 0;
}

.modal-food-list {
  flex: 1;
  min-height: 0;
}

/* Bottom tip */
.bottom-tip {
  text-align: center;
  font-size: 26rpx;
  color: #888;
  padding: 8rpx 0 32rpx;
  line-height: 1.8;
}

.top-tip {
  padding: 4rpx 8rpx 24rpx;
}

/* Search */
.search-wrap {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  background: transparent;
}

/* Category tabs */
.cat-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}
.cat-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #888;
  background: #F5F5F5;
  border: 2rpx solid transparent;
  white-space: nowrap;
  transition: all 0.2s ease;
}
.cat-tab.active {
  background: linear-gradient(135deg, #1AAD74, #179964);
  color: #FFFFFF;
  font-weight: 700;
  border-color: rgba(26, 173, 116, 0.18);
  box-shadow: 0 8rpx 18rpx rgba(26, 173, 116, 0.22);
}

.modal-food-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.modal-food-item:active { background: #F9F9F9; }
.mfi-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}
.mfi-cat-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.mfi-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.mfi-sub {
  font-size: 20rpx;
  color: #BBB;
  margin-top: 4rpx;
  line-height: 1.6;
}
.mfi-source {
  font-weight: 600;
}
.mfi-custom-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}
.mfi-custom-label {
  font-size: 20rpx;
  color: #8A94A6;
}
.mfi-custom-input {
  width: 96rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #F6F8FB;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #162033;
  box-sizing: border-box;
}
.mfi-custom-unit {
  font-size: 20rpx;
  color: #8A94A6;
}
.mfi-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
  padding-top: 4rpx;
}
.mfi-kcal {
  font-size: 32rpx;
  font-weight: 800;
  color: #1AAD74;
  line-height: 1;
}
.mfi-kcal-lbl {
  font-size: 20rpx;
  color: #AAA;
}
.no-result {
  text-align: center;
  color: #CCC;
  font-size: 26rpx;
  padding: 60rpx 0;
}
