.page-wrap {
  min-height: 100vh;
  padding: 28rpx 24rpx;
  background: #f4f6fa;
  box-sizing: border-box;
}

.placeholder-card {
  padding: 48rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.05);
}

.placeholder-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #475569;
  font-size: 20rpx;
}

.placeholder-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #122033;
}

.placeholder-desc {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #667085;
}
